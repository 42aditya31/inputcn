{
  "name": "@inputcn/cron",
  "version": "0.1.1",
  "description": "Cron schedule input for React with a plain-English preview and a visual builder.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/42aditya31/inputcn.git",
    "directory": "packages/cron"
  },
  "homepage": "https://input-cn.vercel.app/components/cron-input",
  "bugs": {
    "url": "https://github.com/42aditya31/inputcn/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cron": {
      "types": "./dist/cron.d.ts",
      "import": "./dist/cron.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inputcn/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "zod": "^3.23.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "keywords": [
    "react",
    "cron",
    "input",
    "shadcn",
    "inputcn"
  ]
}
