{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "inputcn",
  "homepage": "https://inputcn.dev",
  "items": [
    {
      "name": "inputcn-base",
      "type": "registry:file",
      "title": "inputcn base styles",
      "description": "Token-driven stylesheet for every inputcn component. Reads your shadcn CSS variables; hardcodes no colour or radius. Import once.",
      "dependencies": [
        "@inputcn/core"
      ],
      "files": [
        {
          "path": "packages/core/styles/inputcn.css",
          "type": "registry:file",
          "target": "components/inputcn/inputcn.css"
        }
      ]
    },
    {
      "name": "phone-input",
      "type": "registry:ui",
      "title": "Phone Input",
      "description": "Phone number field with a searchable country selector, live per-country formatting and E.164 output. Smart paste detects the country and offers an undo.",
      "dependencies": [
        "@inputcn/core",
        "@inputcn/phone"
      ],
      "registryDependencies": [
        "inputcn-base"
      ],
      "files": [
        {
          "path": "packages/phone/src/phone-input.tsx",
          "type": "registry:ui",
          "target": "components/inputcn/phone/phone-input.tsx"
        },
        {
          "path": "packages/phone/src/use-phone-input.ts",
          "type": "registry:hook",
          "target": "components/inputcn/phone/use-phone-input.ts"
        },
        {
          "path": "packages/phone/src/phone.ts",
          "type": "registry:lib",
          "target": "components/inputcn/phone/phone.ts"
        },
        {
          "path": "packages/phone/src/countries.ts",
          "type": "registry:lib",
          "target": "components/inputcn/phone/countries.ts"
        }
      ]
    },
