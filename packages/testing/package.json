{
  "name": "@inputcn/testing",
  "version": "0.1.0",
  "description": "Test helpers for inputcn components. Formatted inputs are hard to drive with userEvent; these do it correctly.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fill": {
      "types": "./dist/fill.d.ts",
      "import": "./dist/fill.js"
    },
    "./assert": {
      "types": "./dist/assert.d.ts",
      "import": "./dist/assert.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inputcn/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "@testing-library/react": ">=14",
    "@testing-library/dom": ">=9",
    "@testing-library/user-event": ">=14"
  },
  "keywords": [
    "react",
    "testing",
    "testing-library",
    "input",
    "shadcn",
    "inputcn"
  ]
}
